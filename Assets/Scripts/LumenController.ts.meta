    - '// @input float deskDepthCm = 86 {"hint":"Desk depth (cm)."}'
    - '// @input vec2 footprintSizeCm = {36,25.6} {"hint":"Laptop footprint size W x D (cm)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Lights"}'
    - '// @input float ceilingLumens = 1000 {"hint":"Ceiling LED module flux (lm)."}'
    - '// @input float ceilingConeDeg = 180 {"hint":"Ceiling module emission cone, full angle (degrees, pointing down). 180 = downward hemisphere, >= 360 = all directions."}'
    - '// @input float lampLumens = 600 {"hint":"Desk lamp flux (lm)."}'
    - '// @input float lampHeightCm = 50 {"hint":"Lamp bulb height above the desk (cm)."}'
