    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">LumenController – desk illuminance estimator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject desk {"hint":"Desk root; its world position is the centre of the desk TOP surface."}'
    - '// @input SceneObject ceilingLight {"hint":"Ceiling bulb marker (fixed). Its world position is the light source."}'
